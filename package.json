{
  "name": "school-backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node start.js",
    "dev": "node --watch start.js",
    "backup:db": "node scripts/renderDbBackup.js",
    "backup:verify": "node scripts/verifyBackupRestore.js",
    "backup:restore": "node scripts/restoreFromS3.js",
    "tenant:bootstrap": "node scripts/bootstrapDefaultSchoolTenant.js",
    "create:admin": "node scripts/createAdmin.js",
    "create:signup-invite": "node scripts/createSignupInvite.js",
    "test": "vitest run",
    "test:all": "vitest run --config vitest.all.config.js",
    "test:e2e": "vitest run --config vitest.e2e.config.js",
    "test:load": "vitest run --config vitest.load.config.js",
    "test:smoke": "vitest run --config vitest.smoke.config.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:socket-load": "node tests/socket-load-test.js",
    "audit": "npm audit --audit-level=moderate",
    "migrate": "node scripts/migrate.js",
    "migrate:up": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:dry-run": "node scripts/migrate.js up --dry-run",
    "migrate:indexes": "node scripts/migrateIndexes.js",
    "reencrypt:pii": "node scripts/reencryptPii.js",
    "reencrypt:pii:apply": "node scripts/reencryptPii.js --apply",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || exit 0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@node-saml/node-saml": "^5.0.0",
    "@sentry/node": "^10.70.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "agenda": "^6.2.5",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^13.6.0",
    "helmet": "^8.3.0",
    "i18next": "^26.4.0",
    "i18next-http-middleware": "^3.9.8",
    "ioredis": "^5.11.1",
    "joi": "^18.2.5",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "8.24.1",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "nodemailer": "^9.0.5",
    "otplib": "^13.4.1",
    "pdfkit": "^0.19.1",
    "peer": "^1.0.2",
    "pino": "^10.3.1",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^5.0.0",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "overrides": {
    "tar": "^7.5.11",
    "socket.io-parser": ">=4.2.6",
    "flatted": ">=3.4.2",
    "fast-xml-parser": ">=5.5.7",
    "body-parser": ">=1.20.6",
    "brace-expansion": ">=5.0.8",
    "protobufjs": ">=7.6.5",
    "websocket-driver": ">=0.7.5",
    "@tootallnate/once": "^3.0.1",
    "http-proxy-agent": "^7.0.0",
    "teeny-request": "^10.1.2",
    "uuid": ">=11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.6",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
