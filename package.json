{
  "name": "school-backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node start.js",
    "dev": "node --watch start.js",
    "backup:db": "node scripts/renderDbBackup.js",
    "backup:verify": "node scripts/verifyBackupRestore.js",
    "tenant:bootstrap": "node scripts/bootstrapDefaultSchoolTenant.js",
    "create:admin": "node scripts/createAdmin.js",
    "create:signup-invite": "node scripts/createSignupInvite.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:socket-load": "node tests/socket-load-test.js",
    "audit": "npm audit --audit-level=moderate",
    "migrate": "node scripts/migrate.js",
    "migrate:up": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:dry-run": "node scripts/migrate.js up --dry-run",
    "migrate:indexes": "node scripts/migrateIndexes.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || exit 0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0",
    "@node-saml/node-saml": "^5.0.0",
    "@sentry/node": "^8.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "agenda": "^5.0.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^13.6.0",
    "helmet": "^8.0.0",
    "i18next": "^25.8.18",
    "i18next-http-middleware": "^3.9.2",
    "ioredis": "^5.10.0",
    "joi": "^17.12.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.3",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "nodemailer": "^8.0.7",
    "otplib": "^13.3.0",
    "pdfkit": "^0.17.2",
    "peer": "^1.0.2",
    "pino": "^10.3.1",
    "pino-loki": "^2.4.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "overrides": {
    "tar": "^7.5.11",
    "socket.io-parser": ">=4.2.6",
    "flatted": ">=3.4.2",
    "fast-xml-parser": ">=5.5.7",
    "@tootallnate/once": "^3.0.1",
    "http-proxy-agent": "^7.0.0",
    "teeny-request": "^10.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mongodb-memory-server": "^11.0.1",
    "prettier": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
