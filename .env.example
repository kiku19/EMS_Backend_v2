# MongoDB Connection String
# ===========================

# Option 1: Local MongoDB (requires MongoDB installed)
# MONGODB_URI=mongodb://localhost:27017/school_db

# Option 2: MongoDB Atlas (FREE cloud database)
# 1. Go to https://www.mongodb.com/atlas
# 2. Create a free account and cluster
# 3. Get your connection string and replace below:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/school_db

# Current setting (update this):
MONGODB_URI=mongodb://localhost:27017/school_db

PORT=3001

# JWT secrets (required in all environments; generate each separately with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace-with-a-unique-64-char-random-hex
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-hex

# Razorpay (required for parent-app fee payments)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ===================
# Messaging Services
# ===================

# Email Service (Nodemailer + SMTP)
# For development: Use Gmail SMTP (free, 500 emails/day)
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the App Password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# For production: Use SendGrid ($15/month, 100 emails/day free)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=YOUR_SENDGRID_API_KEY

# SMS Service (MSG91)
# 1. Sign up at https://msg91.com
# 2. Get your Auth Key from dashboard
# 3. Create a Sender ID (needs DLT approval for India)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=your-sender-id
MSG91_FLOW_ID=your-flow-id
MSG91_COUNTRY=91

# WhatsApp Service (MSG91)
# Enable if you want to send WhatsApp messages
MSG91_WHATSAPP_ENABLED=true
MSG91_WHATSAPP_SENDER_PHONE=919876543210

# ===================
# Background Jobs
# ===================

# Agenda Job Scheduler (MongoDB-based)
AGENDA_DB_COLLECTION=jobs
AGENDA_PROCESS_EVERY=5_seconds

# Render backup job (optional locally, required if you enable the Render cron service)
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=ap-south-1
BACKUP_S3_ACCESS_KEY_ID=your-backup-access-key
BACKUP_S3_SECRET_ACCESS_KEY=your-backup-secret
BACKUP_S3_PREFIX=ems-backups
# Optional for S3-compatible providers such as Cloudflare R2 or MinIO
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
BACKUP_S3_FORCE_PATH_STYLE=false

# ===================
# Video Calling
# ===================

# PeerJS Server
PEERJS_PORT=9000
PEERJS_PATH=/peerjs

# STUN Servers (free Google STUN for development)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN Server (optional, for production NAT traversal)
# Sign up with a TURN service or self-host using coturn
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_SERVER_USERNAME=your-username
TURN_SERVER_PASSWORD=your-password

# ===================
# Application Settings
# ===================

# School Name (used in emails/messages)
SCHOOL_NAME=Your School Name

# Frontend URL (for links in emails)
FRONTEND_URL=http://localhost:5173

# ===================
# AI Assistant
# ===================

# Backend-only AI provider keys. Do not expose these in VITE_ variables.
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-pro

# Default model id exposed to the dashboard model picker
AI_DEFAULT_MODEL_ID=groq

# Parent app URL (used for CORS allowlisting in production)
PARENT_APP_URL=http://localhost:19006

# Explicit production CORS allowlist when deploying
CORS_ORIGIN=http://localhost:5173,http://localhost:19006
