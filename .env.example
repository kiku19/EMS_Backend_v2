# MongoDB Connection String
# ===========================

# Option 1: Local MongoDB (requires MongoDB installed)
# MONGODB_URI=mongodb://localhost:27017/school_db

# Option 2: MongoDB Atlas (FREE cloud database)
# 1. Go to https://www.mongodb.com/atlas
# 2. Create a free account and cluster
# 3. Get your connection string and replace below:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/school_db

# Current setting (update this):
MONGODB_URI=mongodb://localhost:27017/school_db

PORT=3001

# JWT secrets (required in all environments; generate each separately with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace-with-a-unique-64-char-random-hex
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-hex

# ===================
# Cloudinary (required for file/photo uploads — staff profile photos, documents, etc.)
# ===================
# 1. Sign up at https://cloudinary.com (free tier: 25GB storage, 25GB bandwidth/month)
# 2. Get credentials from: Cloudinary Console > Settings > API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Without these, POST /upload returns 503 and staff profile photo upload will fail.

# Razorpay (required for parent-app fee payments)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ===================
# Firebase Admin SDK (required for parent OTP login and push notifications)
# ===================
#
# Option 1 — Full service account JSON (recommended for production):
# Download from Firebase Console > Project Settings > Service Accounts > Generate new private key
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-admin@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
#
# Option 2 — Individual environment variables:
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-admin@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# FIREBASE_PRIVATE_KEY_ID=abc123def456
# FIREBASE_CLIENT_ID=123456789012345678901
#
# Option 3 — Service account key file path:
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account.json
#
# Note: Without Firebase configuration, parent OTP login and push notifications
# are disabled. Password-based parent login and in-app notifications still work.

# ===================
# Web Push / VAPID (optional — enables browser push notifications for dashboard)
# ===================
# Generate keys with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_CONTACT_EMAIL=admin@yourschool.com

# ===================
# Messaging Services
# ===================

# Email Service (Nodemailer + SMTP)
# For development: Use Gmail SMTP (free, 500 emails/day)
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the App Password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# For production: Use SendGrid ($15/month, 100 emails/day free)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=YOUR_SENDGRID_API_KEY

# SMS Service (MSG91)
# 1. Sign up at https://msg91.com
# 2. Get your Auth Key from dashboard
# 3. Create a Sender ID (needs DLT approval for India)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=your-sender-id
MSG91_FLOW_ID=your-flow-id
MSG91_COUNTRY=91

# WhatsApp Service (MSG91)
# Enable if you want to send WhatsApp messages
MSG91_WHATSAPP_ENABLED=true
MSG91_WHATSAPP_SENDER_PHONE=919876543210

# ===================
# Background Jobs
# ===================

# Agenda Job Scheduler (MongoDB-based)
AGENDA_DB_COLLECTION=jobs
AGENDA_PROCESS_EVERY=5_seconds

# Render backup job (optional locally, required if you enable the Render cron service)
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=ap-south-1
BACKUP_S3_ACCESS_KEY_ID=your-backup-access-key
BACKUP_S3_SECRET_ACCESS_KEY=your-backup-secret
BACKUP_S3_PREFIX=ems-backups
# Optional for S3-compatible providers such as Cloudflare R2 or MinIO
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
BACKUP_S3_FORCE_PATH_STYLE=false

# ===================
# Video Calling
# ===================

# PeerJS Server
PEERJS_PORT=9000
PEERJS_PATH=/peerjs

# STUN Servers (free Google STUN for development)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN Server (optional, for production NAT traversal)
# Sign up with a TURN service or self-host using coturn
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_SERVER_USERNAME=your-username
TURN_SERVER_PASSWORD=your-password

# ===================
# Application Settings
# ===================

# School Name (used in emails/messages)
SCHOOL_NAME=Your School Name

# Frontend URL (for links in emails)
FRONTEND_URL=http://localhost:5173

# ===================
# AI Assistant
# ===================

# Backend-only AI provider keys. Do not expose these in VITE_ variables.
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-pro

# Default model id exposed to the dashboard model picker
AI_DEFAULT_MODEL_ID=groq

# ===================
# Redis (optional — enables distributed cache, rate limiting, and multi-instance Socket.IO)
# ===================

# Local dev (requires Redis installed, e.g. brew install redis && redis-server)
# REDIS_URL=redis://localhost:6379

# Render managed Redis — set this in your Render service environment variables
# REDIS_URL=redis://<user>:<password>@<host>:<port>

# AWS ElastiCache (TLS)
# REDIS_URL=rediss://<user>:<password>@<host>:6380

# Parent app URL (used for CORS allowlisting in production)
PARENT_APP_URL=http://localhost:19006

# Explicit production CORS allowlist when deploying
CORS_ORIGIN=http://localhost:5173,http://localhost:19006

# ===================
# Error Tracking (Sentry)
# ===================
# Optional: Captures API errors and performance data in production.
# 1. Create a Node.js project at https://sentry.io
# 2. Copy the DSN from Settings > Client Keys
# SENTRY_DSN=https://your-key@o000000.ingest.sentry.io/0000000

# ===================
# Logging & Observability (OBS-03)
# ===================

# Log level override (fatal | error | warn | info | debug | trace)
# Defaults: warn in production, debug in development
# LOG_LEVEL=info

# Disable pino-pretty pretty-printing even in development
# LOG_PRETTY=false

# ── Grafana Loki (in-process shipping via pino-loki) ───────────────────────
# LOKI_URL=http://localhost:3100
#
# For Grafana Cloud (basic auth):
# LOKI_URL=https://logs-prod-xx.grafana.net
# LOKI_USERNAME=your-grafana-cloud-user-id
# LOKI_PASSWORD=your-grafana-cloud-api-key

# ── Datadog (in-process shipping) ────────────────────────────────────────────
# Requires: npm i pino-datadog-transport
# DD_API_KEY=your-datadog-api-key
#
# Alternative: Install the Datadog Agent on your server and it will collect
# JSON logs from stdout automatically — no npm package required.

# ── Elasticsearch / ELK (in-process shipping) ────────────────────────────────
# Requires: npm i pino-elasticsearch
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_INDEX=ems-logs
# ELASTICSEARCH_API_KEY=your-api-key
#
# Alternative: Install Filebeat on your server to collect stdout JSON logs.

# NOTE: Without any of the above env vars, logs are written as JSON to stdout.
# A sidecar agent (Promtail for Loki, Filebeat for ELK, Datadog Agent for DD)
# can collect them from stdout — see infra/docker-compose.logging.yml for a
# ready-to-use Loki + Grafana + Promtail local stack.
