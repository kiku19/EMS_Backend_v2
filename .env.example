# MongoDB Connection String
# ===========================

# Option 1: Local MongoDB (requires MongoDB installed)
# MONGODB_URI=mongodb://localhost:27017/school_db

# Option 2: MongoDB Atlas (FREE cloud database)
# 1. Go to https://www.mongodb.com/atlas
# 2. Create a free account and cluster
# 3. Get your connection string and replace below:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/school_db

# Current setting (update this):
MONGODB_URI=mongodb://localhost:27017/school_db

PORT=3001

# ===================
# Messaging Services
# ===================

# Email Service (Nodemailer + SMTP)
# For development: Use Gmail SMTP (free, 500 emails/day)
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the App Password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# For production: Use SendGrid ($15/month, 100 emails/day free)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=YOUR_SENDGRID_API_KEY

# SMS Service (MSG91)
# 1. Sign up at https://msg91.com
# 2. Get your Auth Key from dashboard
# 3. Create a Sender ID (needs DLT approval for India)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=your-sender-id
MSG91_FLOW_ID=your-flow-id
MSG91_COUNTRY=91

# WhatsApp Service (MSG91)
# Enable if you want to send WhatsApp messages
MSG91_WHATSAPP_ENABLED=true
MSG91_WHATSAPP_SENDER_PHONE=919876543210

# ===================
# Background Jobs
# ===================

# Agenda Job Scheduler (MongoDB-based)
AGENDA_DB_COLLECTION=jobs
AGENDA_PROCESS_EVERY=5_seconds

# ===================
# Video Calling
# ===================

# PeerJS Server
PEERJS_PORT=9000
PEERJS_PATH=/peerjs

# STUN Servers (free Google STUN for development)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN Server (optional, for production NAT traversal)
# Sign up with a TURN service or self-host using coturn
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_SERVER_USERNAME=your-username
TURN_SERVER_PASSWORD=your-password

# ===================
# Application Settings
# ===================

# School Name (used in emails/messages)
SCHOOL_NAME=Your School Name

# Frontend URL (for links in emails)
FRONTEND_URL=http://localhost:5173
