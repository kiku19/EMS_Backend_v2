# Docker environment variables
# Copy this file and fill in real values before running docker-compose

# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── MongoDB ────────────────────────────────────────────────────────────────────
# Points to the 'mongo' service defined in docker-compose.yml
MONGODB_URI=mongodb://mongo:27017/school_db

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-unique-64-char-random-hex
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-hex

# ── CORS ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
PARENT_APP_URL=http://localhost:19006
CORS_ORIGIN=http://localhost:5173,http://localhost:19006

# ── Email (Nodemailer) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── SMS (MSG91) ────────────────────────────────────────────────────────────────
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=your-sender-id
MSG91_FLOW_ID=your-flow-id
MSG91_COUNTRY=91
MSG91_WHATSAPP_ENABLED=false
MSG91_WHATSAPP_SENDER_PHONE=919876543210

# ── Payments (Razorpay) ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ── File Storage (Cloudinary) ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── AI ─────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-pro
AI_DEFAULT_MODEL_ID=groq

# ── Background Jobs (Agenda) ───────────────────────────────────────────────────
AGENDA_DB_COLLECTION=jobs
AGENDA_PROCESS_EVERY=5_seconds

# ── S3 Backup ──────────────────────────────────────────────────────────────────
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=ap-south-1
BACKUP_S3_ACCESS_KEY_ID=your-access-key
BACKUP_S3_SECRET_ACCESS_KEY=your-secret
BACKUP_S3_PREFIX=ems-backups
BACKUP_S3_FORCE_PATH_STYLE=false

# ── Video Calling (PeerJS) ─────────────────────────────────────────────────────
PEERJS_PORT=9000
PEERJS_PATH=/peerjs
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_SERVER_USERNAME=your-username
TURN_SERVER_PASSWORD=your-password

# ── Redis ──────────────────────────────────────────────────────────────────────
# Points to the 'redis' service defined in docker-compose.yml
REDIS_URL=redis://redis:6379

# ── Misc ───────────────────────────────────────────────────────────────────────
SCHOOL_NAME=Your School Name
