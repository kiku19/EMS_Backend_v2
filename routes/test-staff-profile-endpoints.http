# Staff Profile Update Endpoints - Test Collection
# Use with REST Client extension in VS Code or similar tools

# Base URL - Update this to match your server
@baseUrl = http://localhost:3000/api/mobile
@staffId = YOUR_STAFF_ID_HERE
@token = YOUR_JWT_TOKEN_HERE

### ============================================================================
### GET /api/mobile/staff/:staffId/profile
### Get staff profile for self-service updates
### ============================================================================

# Get own profile (authenticated)
GET {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}

###

# Get profile with invalid staff ID (should return 404)
GET {{baseUrl}}/staff/507f1f77bcf86cd799439011/profile
Authorization: Bearer {{token}}

###

# Get profile without authentication (should return 401)
GET {{baseUrl}}/staff/{{staffId}}/profile

### ============================================================================
### PUT /api/mobile/staff/:staffId/profile
### Update staff profile (self-service)
### ============================================================================

# Update phone number only
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "phone": "9876543210"
}

###

# Update email only
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "updated@example.com"
}

###

# Update WhatsApp number
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "whatsappNumber": "9876543210"
}

###

# Update blood group
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "bloodGroup": "A+"
}

###

# Update marital status
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "maritalStatus": "Married"
}

###

# Update address
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "address": "123 Main Street, City, State - 123456"
}

###

# Update emergency contacts
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "emergencyContacts": [
    {
      "name": "John Doe",
      "relationship": "Spouse",
      "phone": "9876543210"
    },
    {
      "name": "Jane Smith",
      "relationship": "Parent",
      "phone": "9876543211"
    }
  ]
}

###

# Update profile picture
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "picture": "https://example.com/photos/staff-123.jpg"
}

###

# Update multiple fields at once
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "phone": "9876543210",
  "email": "newemail@example.com",
  "whatsappNumber": "9876543210",
  "bloodGroup": "B+",
  "maritalStatus": "Married",
  "address": "456 Oak Avenue, Apt 10"
}

###

# Update with invalid email format (should return 400)
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "invalid-email"
}

###

# Update with invalid phone format (should return 400)
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "phone": "12345"
}

###

# Update with invalid blood group (should return 400)
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "bloodGroup": "XYZ"
}

###

# Update with invalid marital status (should return 400)
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "maritalStatus": "Unknown"
}

###

# Update with admin-only field (should return 403)
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "salary": 50000
}

###

# Update with role field (admin-only, should return 403)
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role": ["Admin"]
}

###

# Update with no changes (should return 200 with "No changes to update")
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "phone": "{{existing_phone_number}}"
}

###

# Update without authentication (should return 401)
PUT {{baseUrl}}/staff/{{staffId}}/profile
Content-Type: application/json

{
  "phone": "9876543210"
}

###

# Update with invalid emergency contact (missing required field, should return 400)
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "emergencyContacts": [
    {
      "name": "John Doe"
      // Missing 'relationship' and 'phone'
    }
  ]
}

###

# Update with too many emergency contacts (should return 400, max is 5)
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "emergencyContacts": [
    {
      "name": "Contact 1",
      "relationship": "Spouse",
      "phone": "9876543210"
    },
    {
      "name": "Contact 2",
      "relationship": "Parent",
      "phone": "9876543211"
    },
    {
      "name": "Contact 3",
      "relationship": "Sibling",
      "phone": "9876543212"
    },
    {
      "name": "Contact 4",
      "relationship": "Friend",
      "phone": "9876543213"
    },
    {
      "name": "Contact 5",
      "relationship": "Colleague",
      "phone": "9876543214"
    },
    {
      "name": "Contact 6",
      "relationship": "Other",
      "phone": "9876543215"
    }
  ]
}

###

# Update with invalid emergency contact phone format (should return 400)
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "emergencyContacts": [
    {
      "name": "John Doe",
      "relationship": "Spouse",
      "phone": "12345"
    }
  ]
}

###

# Update with empty object (should return 400)
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
}

### ============================================================================
### Test Edge Cases
### ============================================================================

# Address exceeds max length (200 characters, should return 400)
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "address": "Lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore magna aliqua Ut enim ad minim veniam quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur Excepteur sint occaecat cupidatat non proident sunt in culpa qui officia deserunt mollit anim id est laborum"
}

###

# Update with invalid picture URL (should return 400)
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "picture": "not-a-valid-url"
}

### ============================================================================
### Security Tests
### ============================================================================

# Try to update another staff's profile (without admin, should return 403)
PUT {{baseUrl}}/staff/507f1f77bcf86cd799439012/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "phone": "9876543210"
}

###

# Try to update name field (admin-only, should return 403)
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "New Name"
}

###

# Try to update department field (admin-only, should return 403)
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "department": "New Department"
}

###

# Try to update status field (admin-only, should return 403)
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "inactive"
}

###

# Try to update employmentType field (admin-only, should return 403)
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "employmentType": "Contract"
}

###

# Try to update bank details (admin-only, should return 403)
PUT {{baseUrl}}/staff/{{staffId}}/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "accountNumber": "1234567890",
  "ifscCode": "ABCD0123456"
}
