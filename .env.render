# Copy these to Render Environment Variables
# Go to: Render Dashboard > Your Service > Environment

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/school_db?retryWrites=true&w=majority
PORT=10000
NODE_ENV=production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-hex
JWT_REFRESH_SECRET=replace-with-another-64-char-random-hex

# Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# CORS - Frontend URL on Vercel
CORS_ORIGIN=https://your-school-dashboard.vercel.app

# Firebase Admin SDK (required for parent OTP login and push notifications)
# Paste the full service account JSON from Firebase Console > Project Settings > Service Accounts
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Web Push / VAPID (optional — for browser push notifications)
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_CONTACT_EMAIL=admin@yourschool.com

# Optional
LOG_LEVEL=INFO
